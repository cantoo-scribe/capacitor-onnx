{
  "name": "@cantoo/capacitor-onnx",
  "version": "1.0.0",
  "description": "Capacitor plugin for native ONNX Runtime inference on Android",
  "packageManager": "pnpm@10.30.3",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "android/src",
    "android/build.gradle",
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json"
  },
  "keywords": [
    "capacitor",
    "android",
    "onnx",
    "onnxruntime"
  ],
  "license": "MIT",
  "capacitor": {
    "android": {
      "src": "android"
    }
  },
  "peerDependencies": {
    "@capacitor/core": ">=7.0.0"
  },
  "devDependencies": {
    "@capacitor/core": "^7.0.0",
    "typescript": "^5.6.3"
  }
}
